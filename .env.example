# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Point this at whichever PostgreSQL/TimescaleDB you actually want to write to.
# There is no bundled database in docker-compose.yml on purpose: starting a
# second one silently gives the app an empty database while your real data sits
# elsewhere.
#
#   existing server DB : postgres://user:pass@10.0.0.10:65432/energymanager
#   bundled local DB   : postgres://energymanager:changeme@timescaledb:5432/energymanager
#                        (only with -f docker-compose.local-db.yml)
DATABASE_URL=postgres://energymanager:changeme@10.0.0.10:65432/energymanager

# Only used by docker-compose.local-db.yml, to initialise the bundled database.
POSTGRES_USER=energymanager
POSTGRES_PASSWORD=changeme
POSTGRES_DB=energymanager

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# Host port for the UI. On Unraid, 80 is the Unraid web UI itself and 8080
# collides with many community apps — pick something free.
WEB_PORT=8080

# ---------------------------------------------------------------------------
# Home Assistant
# ---------------------------------------------------------------------------
# Leaving HA_URL empty disables the integration *silently* — the app still
# starts and looks healthy. If HA data stops arriving after a deploy, check
# these two actually reached the container (docker compose exec api env).
#
# This covers dynamic feed-in rates too: they come from a Home Assistant
# entity, picked per site under Settings → Home Assistant, and sync on the
# same schedule as the statistics. Neither side keeps history, so an interval
# missed while the app and Home Assistant are both down is lost for good —
# the main reason to run this somewhere that stays up.
HA_URL=
HA_TOKEN=
HA_SYNC_ENABLED=true
HA_SYNC_INTERVAL_MINUTES=15
# How far back each scheduled sync re-reads, to pick up late-arriving statistics.
HA_SYNC_LOOKBACK_HOURS=48


# ---------------------------------------------------------------------------
# Authentication (Cloudflare Access)
# ---------------------------------------------------------------------------
# Off by default: every request is then treated as admin, which is correct for
# local development and for a deployment that is only reachable on the LAN.
# Turn it on once the app is exposed publicly.
#
# With it on, the API trusts only the signed JWT that Cloudflare Access puts in
# the Cf-Access-Jwt-Assertion header. The Cf-Access-Authenticated-User-Email
# header is deliberately ignored — it is unsigned, so anything that reaches the
# origin without passing through Cloudflare could forge it.
AUTH_ENABLED=false

# Your Zero Trust team domain, without a scheme.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com

# The Access application's Audience (AUD) tag, from the application's settings.
# This pins a token to *this* app; without it, a token minted for any other
# Access application in the same account would be accepted here.
CF_ACCESS_AUD=

# Roles are resolved from the verified email address, in this order:
#   1. AUTH_ADMIN_EMAILS              -> admin    full read/write
#   2. an address listed on a party   -> the party's role decides: a member is
#                                        a participant, a "viewer" party reads
#                                        everything and writes nothing
#   3. anything else                  -> 403
#
# A participant sees only their own consumption and invoice plus site-level
# community totals — never another participant's figures, and never your
# production, battery, export or investment data. Add their address to the
# party's "emails" on the Import readings page; the same list is used for invoices.
#
# The admin list wins over the parties table, so an admin address that is also
# on a party is never demoted. Comma- or space-separated.
AUTH_ADMIN_EMAILS=you@example.com

# Local development only, with AUTH_ENABLED=false: act as this address instead
# of an anonymous admin, resolved exactly as a real sign-in would be. Use a
# participant's or a viewer party's address to see the app as they do. The api
# refuses to start if this is set while AUTH_ENABLED=true.
AUTH_DEV_AS=

# ---------------------------------------------------------------------------
# Cloudflare Access sync (optional)
# ---------------------------------------------------------------------------
# Keeps one reusable Cloudflare Access policy's allowed-email list in step
# with the parties table: adding a party (or AUTH_ADMIN_EMAILS above) pushes
# their address in, removing one pulls it back out. Leave both unset and the
# feature is simply off — set only one and the app refuses to start (same
# "half-configured is worse than off" rule as AUTH_ENABLED). It also needs at
# least one AUTH_ADMIN_EMAILS address to name the policy after — see below.
#
# No policy id to configure: the policy is found — or, the first time,
# created — by a name derived from the first AUTH_ADMIN_EMAILS address, e.g.
# "14yannick@gmail.com" becomes "em_14yannick". Once it exists it is entirely
# this app's own, so a sync freely recomputes its whole email list rather
# than having to track what it added itself; a domain rule or a country
# requirement added by hand on top of it is left alone either way.
#
# CF_API_TOKEN needs the "Access: Apps and Policies" Edit permission. That
# scope is account-wide: Cloudflare has no way to restrict a token to one
# policy, so this token can edit or delete *any* Access app or policy on the
# account, not just the one this creates. Treat it like HA_TOKEN's more
# dangerous sibling.
CF_API_TOKEN=
# The account id from the Cloudflare dashboard's URL, or `wrangler whoami`.
CF_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Google Drive (optional)
# ---------------------------------------------------------------------------
# Archives each generated invoice PDF to Drive, alongside the zip download.
# Unset simply disables the feature — invoices still generate normally.
#
# A service account, not an OAuth app: create one in Google Cloud Console,
# download its JSON key, and paste the *whole file's contents* here as one
# line (most .env loaders are fine with the embedded \n's in private_key as
# long as it's all on one line — see the example below). This is a server
# credential like HA_TOKEN or CF_API_TOKEN, not per-site config; never typed
# into the app itself.
#
# A regular "My Drive" folder shared with the service account works for
# reading/listing, but Drive refuses uploads into it — a bare service account
# has no storage quota of its own on a personal (non-Workspace) account. Use
# a Shared Drive (needs Google Workspace) instead, and add the service
# account as at least a Content Manager member of it.
#
# Under Settings → Google Drive the app shows the service account's email
# address (something like name@project.iam.gserviceaccount.com) once this is
# set; share the Shared Drive with that address, then paste its id there.
# That membership is also the entire access boundary: the service account
# can only ever see what it's explicitly a member of, nothing else in
# anyone's Drive, regardless of how broad the code's own requested scope is.
#
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","token_uri":"https://oauth2.googleapis.com/token", ...}
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
