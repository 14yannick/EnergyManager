# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Point this at whichever PostgreSQL/TimescaleDB you actually want to write to.
# There is no bundled database in docker-compose.yml on purpose: starting a
# second one silently gives the app an empty database while your real data sits
# elsewhere.
#
#   existing server DB : postgres://user:pass@10.0.0.10:65432/energymanager
#   bundled local DB   : postgres://energymanager:changeme@timescaledb:5432/energymanager
#                        (only with -f docker-compose.local-db.yml)
DATABASE_URL=postgres://energymanager:changeme@10.0.0.10:65432/energymanager

# Only used by docker-compose.local-db.yml, to initialise the bundled database.
POSTGRES_USER=energymanager
POSTGRES_PASSWORD=changeme
POSTGRES_DB=energymanager

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# Host port for the UI. On Unraid, 80 is the Unraid web UI itself and 8080
# collides with many community apps — pick something free.
WEB_PORT=8080

# ---------------------------------------------------------------------------
# BKW dynamic tariff polling
# ---------------------------------------------------------------------------
# BKW serves a rolling ~25h window of quarter-hour feed-in prices and offers no
# history endpoint, so any interval missed while the app is down is lost for
# good. This is the main reason to run the app somewhere that stays up.
BKW_SYNC_ENABLED=true
BKW_SYNC_INTERVAL_MINUTES=30

# ---------------------------------------------------------------------------
# Home Assistant
# ---------------------------------------------------------------------------
# Leaving HA_URL empty disables the integration *silently* — the app still
# starts and looks healthy. If HA data stops arriving after a deploy, check
# these two actually reached the container (docker compose exec api env).
HA_URL=
HA_TOKEN=
HA_SYNC_ENABLED=true
HA_SYNC_INTERVAL_MINUTES=15
# How far back each scheduled sync re-reads, to pick up late-arriving statistics.
HA_SYNC_LOOKBACK_HOURS=48

# ---------------------------------------------------------------------------
# Authentication (Cloudflare Access)
# ---------------------------------------------------------------------------
# Off by default: every request is then treated as admin, which is correct for
# local development and for a deployment that is only reachable on the LAN.
# Turn it on once the app is exposed publicly.
#
# With it on, the API trusts only the signed JWT that Cloudflare Access puts in
# the Cf-Access-Jwt-Assertion header. The Cf-Access-Authenticated-User-Email
# header is deliberately ignored — it is unsigned, so anything that reaches the
# origin without passing through Cloudflare could forge it.
AUTH_ENABLED=false

# Your Zero Trust team domain, without a scheme.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com

# The Access application's Audience (AUD) tag, from the application's settings.
# This pins a token to *this* app; without it, a token minted for any other
# Access application in the same account would be accepted here.
CF_ACCESS_AUD=

# Roles are resolved from the verified email address, in this order:
#   1. AUTH_ADMIN_EMAILS   -> admin       full read/write
#   2. AUTH_VIEWER_EMAILS  -> viewer      reads everything, writes nothing
#   3. an address listed on a party       -> participant
#   4. anything else                      -> 403
#
# A participant sees only their own consumption and invoice plus site-level
# community totals — never another participant's figures, and never your
# production, battery, export or investment data. Add their address to the
# party's "emails" on the Facturation page; the same list is used for invoices.
#
# The lists win over the parties table, so adding yourself as a participant to
# preview their view cannot demote you. Comma- or space-separated.
AUTH_ADMIN_EMAILS=you@example.com
AUTH_VIEWER_EMAILS=
